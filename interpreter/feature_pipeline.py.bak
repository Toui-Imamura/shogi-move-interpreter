"""
F01〜F40 統合パイプライン

役割
----
1. 現在局面 S0 と指し手から S1 を生成
2. F01〜F33 の即時変化を計算
3. 必要に応じて1本のVariationから
   F13 / F15 / F34 / F35 / F36 を計算
4. 必要に応じて複数MCTS Variationから
   F37 / F38 / F39 を計算
5. F01〜F33の即時変化からF40を計算

注意
----
F40は「指し手によって局面がどの程度変化したか」を表す。
F37〜F39はMCTS全体の分析指標なので、F40の入力には直接使用しない。
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Callable, Mapping, Sequence

import cshogi

from features.move_transition import (
    F40MoveTransition,
    compute_move_transition,
)

from interpreter.feature_adapters import (
    compute_f01_f33_deltas,
)

from interpreter.variation_features import (
    VariationFeatureResult,
    compute_variation_features,
)

from interpreter.mcts_features import (
    MCTSFeatureResult,
    compute_mcts_features,
)


# ============================================================
# Generic feature-delta API
# ============================================================

FeatureExtractor = Callable[[Any], float]


@dataclass(frozen=True)
class FeatureValuePair:
    """現在局面と未来局面における1特徴量の値。"""

    current: float
    future: float

    @property
    def delta(self) -> float:
        """未来局面 - 現在局面。"""
        return self.future - self.current


@dataclass(frozen=True)
class FeaturePipelineResult:
    """
    汎用的な特徴量差分計算結果。

    既存のテストおよび外部利用との互換性を維持するために残す。
    """

    feature_values: Mapping[str, FeatureValuePair]

    @property
    def deltas(self) -> dict[str, float]:
        return {
            name: value.delta
            for name, value in self.feature_values.items()
        }

    def get(
        self,
        feature_name: str,
    ) -> FeatureValuePair | None:
        return self.feature_values.get(feature_name)


def compute_feature_deltas(
    current: Any,
    future: Any,
    extractors: Mapping[str, FeatureExtractor],
) -> GenericFeaturePipelineResult:
    """
    任意の特徴量抽出器を使用して差分を計算する。

    これは汎用APIであり、
    将棋用のF01〜F40統合処理とは独立している。
    """

    if current is None:
        raise ValueError("current position must not be None")

    if future is None:
        raise ValueError("future position must not be None")

    feature_values: dict[str, FeatureValuePair] = {}

    for feature_name, extractor in extractors.items():
        current_value = float(extractor(current))
        future_value = float(extractor(future))

        feature_values[feature_name] = FeatureValuePair(
            current=current_value,
            future=future_value,
        )

    return GenericFeaturePipelineResult(
        feature_values=feature_values,
    )


# ============================================================
# F01〜F40 unified pipeline
# ============================================================


@dataclass(frozen=True)
class UnifiedFeaturePipelineResult:
    """
    F01〜F40の統合結果。

    Attributes
    ----------
    before:
        指し手前の局面 S0。

    after:
        指し手直後の局面 S1。

    move:
        実行した指し手。

    immediate_deltas:
        S0→S1のF01〜F33変化量。

    variation:
        1本のVariationに関するF13/F15/F34/F35/F36。

    mcts:
        複数Variationに関するF37/F38/F39。

    f40:
        指し手による局面転換度。
    """

    before: cshogi.Board
    after: cshogi.Board
    move: int

    immediate_deltas: Mapping[str, float]

    variation: VariationFeatureResult | None

    mcts: MCTSFeatureResult | None

    f40: F40MoveTransition

    @property
    def f40_degree(self) -> float:
        """F40の局面転換度。"""
        return float(self.f40.degree)

    def get_delta(
        self,
        feature_name: str,
        default: float = 0.0,
    ) -> float:
        """F01〜F33の即時変化量を取得する。"""
        return float(
            self.immediate_deltas.get(
                feature_name,
                default,
            )
        )


def _validate_move(
    board: cshogi.Board,
    move: int,
) -> None:
    """
    指し手が合法であることを確認する。

    cshogi 1.0.4で確認済みの board.is_legal() を使用する。
    """

    if not board.is_legal(move):
        raise ValueError(
            f"illegal move: {move}"
        )


def _make_after_position(
    before: cshogi.Board,
    move: int,
) -> cshogi.Board:
    """
    指し手直後の局面を作成する。

    beforeそのものは変更しない。

    cshogi 1.0.4で確認済みの
        board.copy()
        board.push()
    を使用する。
    """

    after = before.copy()
    after.push(move)

    return after


def compute_immediate_features(
    before: cshogi.Board,
    move: int,
) -> tuple[cshogi.Board, dict[str, float]]:
    """
    1手によるF01〜F33の即時変化を計算する。

    Returns
    -------
    after:
        指し手直後の局面。

    deltas:
        F01〜F33の変化量。
    """

    if before is None:
        raise ValueError(
            "before position must not be None"
        )

    _validate_move(
        before,
        move,
    )

    after = _make_after_position(
        before,
        move,
    )

    deltas = compute_f01_f33_deltas(
        before,
        after,
        move=move,
    )

    return (
        after,
        {
            name: float(value)
            for name, value in deltas.items()
        },
    )


def compute_pipeline(
    before: cshogi.Board,
    move: int,
    variation_moves: Sequence[str] | None = None,
    mcts_variations: Sequence[Mapping[str, Any]] | None = None,
    feature_weights: Mapping[str, float] | None = None,
) -> UnifiedFeaturePipelineResult:
    """
    F01〜F40を統合して計算する。

    Parameters
    ----------
    before:
        指し手前の局面。

    move:
        実行する指し手。
        cshogiのmove整数。

    variation_moves:
        1本の探索Variation。

        例:
            [
                "7g7f",
                "3c3d",
                "2g2f",
            ]

    mcts_variations:
        複数のMCTS Variation。

        各要素:

            {
                "visits": 10,
                "result": variation_result,
            }

        resultはcompute_variation_features()の結果。

    feature_weights:
        F40で使用する特徴量重み。

    Returns
    -------
    FeaturePipelineResult
    """

    if before is None:
        raise ValueError(
            "before position must not be None"
        )

    # --------------------------------------------------------
    # 1. 指し手によるS0→S1
    # --------------------------------------------------------

    after, immediate_deltas = (
        compute_immediate_features(
            before,
            move,
        )
    )

    # --------------------------------------------------------
    # 2. Variation
    # --------------------------------------------------------

    variation_result = None

    if variation_moves is not None:
        variation_result = compute_variation_features(
            before,
            variation_moves,
        )

    # --------------------------------------------------------
    # 3. 複数MCTS Variation
    # --------------------------------------------------------

    mcts_result = None

    if mcts_variations is not None:
        mcts_result = compute_mcts_features(
            before,
            mcts_variations,
        )

    # --------------------------------------------------------
    # 4. F40
    #
    # F40:
    #
    # sqrt(
    #     Σ λ_i * (Δf_i)^2
    # )
    #
    # 入力:
    #     S0→S1のF01〜F33
    #
    # F37〜F39はMCTS全体の統計指標なので
    # F40には直接入れない。
    # --------------------------------------------------------

    f40 = compute_move_transition(
        current=before,
        future=after,
        feature_deltas=immediate_deltas,
        feature_weights=feature_weights,
    )

    return UnifiedFeaturePipelineResult(
        before=before,
        after=after,
        move=move,
        immediate_deltas=immediate_deltas,
        variation=variation_result,
        mcts=mcts_result,
        f40=f40,
    )


def compute_feature_pipeline(
    before: cshogi.Board,
    move: int,
    variation_moves: Sequence[str] | None = None,
    mcts_variations: Sequence[Mapping[str, Any]] | None = None,
    feature_weights: Mapping[str, float] | None = None,
) -> UnifiedFeaturePipelineResult:
    """
    compute_pipeline()の公開API。
    """

    return compute_pipeline(
        before=before,
        move=move,
        variation_moves=variation_moves,
        mcts_variations=mcts_variations,
        feature_weights=feature_weights,
    )
